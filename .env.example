# ═══════════════════════════════════════════════════════════════════════
# VICENTRA / IBVAP — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values as needed:
#   copy .env.example .env
#
# All values shown below are the defaults used when no .env file exists.
# ═══════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
AUTO_OPEN_BROWSER=true

# ─── Database ────────────────────────────────────────────────────────
# Default: %LOCALAPPDATA%/VICENTRA/data/ibvap.db (auto-created)
# DATABASE_URL=sqlite:///./custom_path.db

# ─── AI / Inference ─────────────────────────────────────────────────
AI_ENABLED=true
AI_MODEL=yolov8n.pt
AI_DEVICE=auto
AI_CONFIDENCE_THRESHOLD=0.4
AI_IOU_THRESHOLD=0.45
AI_INFERENCE_FPS=2.0

# ─── Object Tracking ────────────────────────────────────────────────
TRACKING_ENABLED=true
TRACKING_MAX_MISSED_FRAMES=5
TRACKING_ASSOCIATION_THRESHOLD=50.0

# ─── Virtual Fences & Zones ─────────────────────────────────────────
ZONES_ENABLED=true
ZONE_EVALUATION_FPS=5.0

# ─── Real-Time Alerts & WebSocket ────────────────────────────────────
WS_ENABLED=true
WS_MAX_CLIENTS=50
